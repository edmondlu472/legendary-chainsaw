# Trading Platform Configuration
# Copy to .env and fill in your values

# Mode: paper | live (ALWAYS start with paper)
PLATFORM_MODE=paper
PLATFORM_LOG_LEVEL=INFO
PLATFORM_DB_URL=sqlite:///chainsaw.db

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TIMEOUT=30
IBKR_READONLY=false

# Polygon.io
POLYGON_API_KEY=your_polygon_api_key_here

# Risk Limits
RISK_MAX_POSITION_PCT=0.05
RISK_MAX_PORTFOLIO_DELTA=500
RISK_MAX_PORTFOLIO_VEGA=10000
RISK_MAX_DAILY_DRAWDOWN_PCT=0.03
RISK_MAX_MARGIN_UTILIZATION=0.70
RISK_MAX_CORRELATED_POSITIONS=5
